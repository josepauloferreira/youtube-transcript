# Apenas no servidor. Nunca use NEXT_PUBLIC_ nestas variáveis.
SUPADATA_API_KEY=
# Código compartilhado com pelo menos 16 caracteres (máximo 256).
APP_ACCESS_CODE=
# Opcional: origem HTTPS exata de um domínio próprio, sem caminho ou barra final.
# Codespaces e URLs da Vercel são identificados pelas variáveis da plataforma.
APP_ORIGIN=
